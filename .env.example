# ===================================================================
# ENVIRONMENT SELECTION
# Set to 'local' for local development or 'production' for VPS
# ===================================================================
APP_ENV=local

# ===================================================================
# BACKEND PROXY TARGET FOR WEB DEV PREVIEW (webpack dev server)
# Auto-selected by APP_ENV, or override directly:
# ===================================================================
# --- LOCAL BACKEND ---
BACKEND_PROXY_TARGET=http://127.0.0.1:3000

# --- PRODUCTION BACKEND (VPS 194.164.151.17:3000) ---
# BACKEND_PROXY_TARGET=http://194.164.151.17:3000
